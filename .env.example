# Copie este arquivo para .env e preencha os valores.

# String de conexão do PostgreSQL. Local: `npx prisma dev` ou Docker.
# Produção: um Postgres gerenciado (Neon, Supabase, Railway, RDS, etc).
DATABASE_URL="postgresql://user:password@localhost:5432/crm_platform?schema=public"

# Segredo usado pelo Auth.js pra assinar o cookie de sessão.
# Gere um com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""
