# Copie este arquivo para .env e preencha os valores.

# String de conexão do PostgreSQL. Local: `npx prisma dev` ou Docker.
# Produção: um Postgres gerenciado (Neon, Supabase, Railway, RDS, etc).
DATABASE_URL="postgresql://user:password@localhost:5432/crm_platform?schema=public"

# Só necessário em dev com `npx prisma dev` (pra `prisma migrate dev`
# funcionar). O próprio `npx prisma dev` imprime essa URL quando sobe: é a
# mesma DATABASE_URL, só que na porta seguinte (ex: 51214 -> 51215) — não
# invente um valor, copie o que apareceu no terminal.
SHADOW_DATABASE_URL=""

# Segredo usado pelo Auth.js pra assinar o cookie de sessão.
# Gere um com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""

# E-mail de convite — opcional. Sem RESEND_API_KEY, o convite continua
# funcionando normalmente, só que só pelo link copiável em /settings (ver
# src/lib/email.ts).
# Crie uma conta em https://resend.com, pegue a API key em
# https://resend.com/api-keys.
RESEND_API_KEY=""
# Precisa ser um remetente de um domínio verificado na sua conta Resend
# (https://resend.com/domains). Sem domínio próprio verificado, use
# "onboarding@resend.dev" (funciona só pra enviar pro e-mail da sua própria
# conta Resend — ok pra testar, não pra produção de verdade).
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Login social — opcional. Sem essas variáveis, o botão do provider
# correspondente simplesmente não aparece em /login e /signup (ver
# src/components/social-login-buttons.tsx). Preencha só o(s) que for usar.

# Google: crie credenciais OAuth em https://console.cloud.google.com/apis/credentials
# (tipo "Web application"), com redirect URI:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://SEU_DOMINIO/api/auth/callback/google (produção)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft: registre um app em https://portal.azure.com (Azure AD /
# Entra ID > App registrations), com redirect URI:
#   http://localhost:3000/api/auth/callback/microsoft-entra-id (dev)
#   https://SEU_DOMINIO/api/auth/callback/microsoft-entra-id (produção)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Opcional: só se quiser restringir login a um tenant específico do Azure AD
# em vez de aceitar qualquer conta Microsoft (o padrão é "common").
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/SEU_TENANT_ID/v2.0"
